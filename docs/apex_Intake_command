All four files, complete. Headline changes: zip_code_entry is the universal ingress and carries lead_capture_opened; DEFAULT_INTENT pins all traffic to no_quote; reality_check is now the sole reclassifier with four silent promotion paths; Track D routes its purchase facts to a separate persistence domain; and unknown-step recovery scans for the first unanswered question instead of blindly jumping to a track head.

// ─────────────────────────────────────────────────────────────────────────────

// src/features/intake/types.ts

// Canonical type surface for the Apex Intake Command Center.

// Pure types only — no runtime values, no side effects.

// ─────────────────────────────────────────────────────────────────────────────

/**

 * Top-level track. There is NO upfront router: every session begins on

 * `no_quote` (see DEFAULT_INTENT in flow.ts) and is silently promoted by the

 * soft-reclassification rules at `reality_check`.

 */

export type IntakeIntent =

  | 'no_quote'            // TRACK C — universal ingress track, ~99% of paid traffic

  | 'quote_review'        // TRACK A — written estimate surfaced mid-diagnostic

  | 'appointments_booked' // TRACK B — reps scheduled, nothing in writing

  | 'already_bought';     // TRACK D — signed or installed, post-purchase audit

/**

 * Every addressable node in the engine, including system and terminal nodes.

 * Terminal/degraded IDs are first-class so failure paths are routable rather

 * than thrown. `intent_router` no longer exists — `zip_code_entry` is the

 * single ingress for all traffic.

 */

export type IntakeStepId =

  // ── universal ingress ──

  | 'zip_code_entry'        // ◆ micro-commitment; lowest-friction first tap

  // ── shared spine ──

  | 'trigger'

  | 'depth_probe'

  | 'scope'

  | 'email_gate'            // ◆ THE PIVOT — Tier B partial persist

  | 'qualify_property'

  | 'hoa_notice'

  | 'reality_check'         // ◆ THE RECLASSIFIER — sole track-switch point

  | 'objection_harvest'

  | 'insurance'

  | 'timeline_authority'

  | 'commitment'

  | 'preview'

  | 'phone_optional'

  | 'otp_verify'

  | 'submitting'

  | 'mirror'

  | 'success'

  // ── quote_review (TRACK A) ──

  | 'estimate_freshness'

  | 'estimate_count'

  | 'blocked_reason'

  | 'measurements_check'

  | 'hidden_costs_check'

  | 'warranty_check'

  | 'quoted_total'

  | 'document_access'

  // ── appointments_booked (TRACK B) ──

  | 'appointment_count'

  | 'verbal_price'

  | 'budget_expectation'

  | 'pre_meeting_kit'

  // ── already_bought (TRACK D) ──

  | 'purchase_stage'

  | 'rescission_window'

  | 'permit_status'

  | 'deposit_size'

  | 'post_purchase_concern'

  | 'contract_access'

  // ── terminal / degraded ──

  | 'soft_exit'

  | 'salvaged'

  | 'degraded_email_only'

  | 'error_retry';

/**

 * Lifecycle states. `banked` is the load-bearing one: once reached, a lead row

 * exists server-side and every subsequent failure degrades to a

 * worse-but-valid outcome instead of losing the person.

 */

export type FormStatus =

  | 'idle'

  | 'answering'

  | 'banked'

  | 'deepening'

  | 'previewing'

  | 'verifying'

  | 'submitting'

  | 'errored'

  | 'degraded'

  | 'succeeded'

  | 'salvaged'

  | 'abandoned';

export type LeadGrade = 'A' | 'B' | 'C' | 'D';

// ── Answer shape ────────────────────────────────────────────────────────────

export interface IntakeAnswers {

  // universal ingress

  /**

   * The zip micro-commitment. Stored in answers because it is a form field the

   * predicates read; the reducer mirrors it into `contact.zip` on validation.

   */

  zip_code: string;

  // shared

  trigger:

    | 'hurricane_season'

    | 'insurance_letter'

    | 'energy_bills'

    | 'failing_windows'

    | 'noise_security'

    | 'new_home_remodel';

  depth_probe:

    | 'storm_exposure'

    | 'insurance_rate_or_dropped'

    | 'monthly_cost'

    | 'nothing_just_curious';

  scope: '1_5' | '6_10' | '11_plus' | 'whole_house' | 'unsure';

  qualify_property: 'single_family' | 'condo_townhome' | 'rent' | 'commercial_multi';

  /**

   * The soft-reclassification question:

   * "Has anyone already visited, mentioned a price, or given you paperwork?"

   * Each non-default answer silently promotes the session onto another track.

   */

  reality_check:

    | 'nobody_yet'                 // stay TRACK C

    | 'visited_no_numbers'         // stay TRACK C, ghost flag

    | 'appointments_booked'        // → TRACK B

    | 'verbal_number'              // → TRACK A (soft quote)

    | 'have_paperwork'             // → TRACK A (document)

    | 'already_signed_or_installed'; // → TRACK D

  objection_harvest: ReadonlyArray

    | 'no_idea_fair_price'

    | 'no_salesperson_in_house'

    | 'trust'

    | 'money_financing'

    | 'dont_know_what_i_need'

  >;

  insurance: 'storm_claim' | 'premium_pressure' | 'wind_mitigation' | 'not_related';

  timeline: 'within_month' | '1_3_months' | 'before_storm_season' | 'this_year' | 'no_timeline';

  authority: 'just_me' | 'me_and_partner' | 'proxy_for_family';

  commitment: 'yes' | 'probably' | 'depends_on_baseline';

  // quote_review

  estimate_freshness: 'within_72h' | '4_14_days' | '15_30_days' | '31_plus_days';

  estimate_count: '1' | '2_3' | '4_plus';

  blocked_reason: ReadonlyArray

    'price_high' | 'details_missing' | 'distrusted_rep' | 'confusing_contract' | 'still_comparing'

  >;

  measurements_check: 'yes' | 'no' | 'not_sure';

  hidden_costs_check: 'all_listed' | 'partial_or_none' | 'not_sure';

  warranty_check: 'written' | 'verbal_or_unclear';

  quoted_total_cents: number;

  document_access: 'have_it_now' | 'later' | 'never_received';

  // appointments_booked

  appointment_count: '1' | '2_3' | '4_plus';

  verbal_price_cents: number;

  budget_expectation: 'under_10k' | '10_25k' | '25_50k' | 'over_50k' | 'no_idea';

  // already_bought

  purchase_stage: 'signed_not_installed' | 'installed_and_paid';

  signed_within_3_business_days: boolean;

  permit_status: 'pulled' | 'not_pulled' | 'unknown';

  deposit_band: 'under_10' | '10_33' | 'over_third' | 'paid_in_full';

  post_purchase_concern: ReadonlyArray

    'overpaid' | 'no_permit_inspection' | 'warranty_unclear' | 'install_quality' | 'scope_omitted'

  >;

  contract_access: 'have_it' | 'no_copy';

}

// ── Contact / identity ──────────────────────────────────────────────────────

export interface LeadContact {

  readonly firstName: string | null;

  readonly zip: string | null;

  readonly email: string | null;

  readonly phoneE164: string | null;

  readonly phoneVerifiedAt: string | null;

  readonly smsConsentAt: string | null;

  readonly smsConsentSource: string | null;

}

/** Canonical identifiers. `visitorId` is NOT a `leadId` — never conflate. */

export interface IntakeIdentity {

  readonly visitorId: string;

  readonly sessionId: string;

  /** Minted once per intake OPEN (not per submit). Reopening mints a new one. */

  readonly captureAttemptId: string;

  readonly landingVisitId: string | null;

  /** Server-assigned. Null until the email gate banks the row. */

  readonly leadId: string | null;

}

export interface FailureCounters {

  readonly otpAttempts: number;

  readonly submitAttempts: number;

  readonly lastErrorCode: string | null;

}

export interface RuntimeFlags {

  /** True once a `public.leads` row exists. Gates every degradation path. */

  readonly leadBanked: boolean;

  readonly consentGranted: boolean;

  readonly hoaBranchInserted: boolean;

  /** True after any soft reclassification. Prevents double promotion. */

  readonly reclassified: boolean;

  readonly previewComputed: boolean;

  /** Ghost-quote marker: someone visited but never sent numbers. */

  readonly ghostQuoteFlag: boolean;

}

/** The complete readonly snapshot every predicate receives. */

export interface IntakeState {

  readonly version: 'progressive_intake_v2';

  readonly intent: IntakeIntent;

  /**

   * Always `no_quote` under the soft-reclassification model — preserved so

   * attribution can distinguish "arrived on Track A" (impossible now) from

   * "promoted to Track A".

   */

  readonly originIntent: IntakeIntent;

  readonly currentStepId: IntakeStepId;

  readonly status: FormStatus;

  readonly answers: Readonly<Partial<IntakeAnswers>>;

  readonly contact: LeadContact;

  readonly identity: IntakeIdentity;

  readonly failures: FailureCounters;

  readonly flags: RuntimeFlags;

}

// ── Tier C telemetry / Tier B persistence metadata ──────────────────────────

export type DataLayerEvent =

  | 'lead_capture_opened'

  | 'form_fields_completed'

  | 'lead_capture_started'

  | 'lead_capture_completed'

  | 'lead_magnet_captured';

/** Tier C. Never carries raw PII — hash or redact at emit time. */

export interface TelemetryMeta {

  readonly tier: 'C';

  readonly event: DataLayerEvent | null;

  readonly fieldKey: string | null;

  /** 0 = surface question, 1 = +1 depth follow-up, 2 = drill. */

  readonly depthLevel: 0 | 1 | 2;

  readonly redactValue: boolean;

}

export type LeadCaptureMetadataKey =

  | 'capture_attempt_id'

  | 'landing_visit_id'

  | 'primary_fear'

  | 'quote_count'

  | 'quote_age_days'

  | 'willing_to_wait_for_audit'

  | 'audit_preview_findings'

  | 'whisper_key'

  | 'commitment_given'

  | 'reclassified_from'

  | 'ghost_quote_flag';

export type PersistenceWriteMode =

  | 'none'

  | 'partial_on_blur' // ◆ the abandonment insurance policy

  | 'upsert'

  | 'consent_event';

/**

 * Which server-side domain a write belongs to. `lead_intake` targets

 * `public.leads` (+ `lead_capture_metadata`). `verified_purchase_audit`

 * targets the SEPARATE verified-purchases lane — completed, signed

 * transactions must never be co-mingled with unverified contractor quotes,

 * because the verified table is the benchmark corpus the audit engine

 * compares quotes AGAINST.

 */

export type PersistenceDomain = 'lead_intake' | 'verified_purchase_audit';

/** Tier B. Any node with `tier: 'B'` implies a schema-backed write. */

export interface PersistenceMeta {

  readonly tier: 'B' | null;

  readonly writeMode: PersistenceWriteMode;

  readonly domain: PersistenceDomain;

  readonly metadataKeys: readonly LeadCaptureMetadataKey[];

  readonly requiresConsent: boolean;

}

export type RouteNodeKind = 'question' | 'gate' | 'system' | 'terminal';

export interface RouteNode {

  readonly id: IntakeStepId;

  readonly kind: RouteNodeKind;

  readonly optional: boolean;

  /** Terminal nodes end the run; the resolver never advances past them. */

  readonly terminal: boolean;

  /**

   * The answers key this node fills, when it is a question. Drives the

   * unknown-step recovery scan ("first unanswered question wins").

   */

  readonly answerKey: keyof IntakeAnswers | null;

  readonly telemetry: TelemetryMeta;

  readonly persistence: PersistenceMeta;

}

// ── Flow + conditional routing contracts ────────────────────────────────────

export interface IntentFlow {

  readonly intent: IntakeIntent;

  readonly label: string;

  readonly sequence: readonly IntakeStepId[];

  /** The email gate. Everything before it is at risk; everything after is banked. */

  readonly pivotStepId: Extract<IntakeStepId, 'email_gate'>;

  readonly terminalStepId: Extract<IntakeStepId, 'success'>;

  /**

   * Server persistence domain for track-specific facts gathered on this flow.

   * TRACK D is the only flow whose diagnostic facts belong to the

   * verified-purchase lane.

   */

  readonly persistenceDomain: PersistenceDomain;

}

/** Pure. Must not read clocks, storage, or network. */

export type RoutePredicate = (state: Readonly<IntakeState>) => boolean;

export type RouteResolution =

  | { readonly kind: 'continue' }

  | { readonly kind: 'goto'; readonly stepId: IntakeStepId }

  | { readonly kind: 'skip'; readonly stepIds: readonly IntakeStepId[] }

  | { readonly kind: 'insert'; readonly after: IntakeStepId; readonly stepIds: readonly IntakeStepId[] }

  | {

      readonly kind: 'reclassify';

      readonly intent: IntakeIntent;

      readonly resumeAtStepId: IntakeStepId;

      /**

       * Structurally locked to `true`: reclassification is a lens change, not

       * a restart. The reducer MUST carry `answers`, `contact`, `identity`,

       * and `flags` forward verbatim — zip, trigger, and every banked field

       * survive the track switch.

       */

      readonly preserveAnswers: true;

    }

  | { readonly kind: 'terminate'; readonly stepId: IntakeStepId; readonly grade: LeadGrade };

/** Pure. Same signature family as the predicate — no side effects. */

export type RouteResolver = (state: Readonly<IntakeState>) => RouteResolution;

export interface RouteCondition {

  readonly id: string;

  readonly description: string;

  /** Lower runs first. First match wins; evaluation short-circuits. */

  readonly priority: number;

  readonly appliesTo: readonly IntakeIntent[] | 'all';

  readonly appliesAtStep: readonly IntakeStepId[] | 'any';

  readonly when: RoutePredicate;

  readonly then: RouteResolver;

}

