const NO_PERSIST: PersistenceMeta = {

  tier: null,

  writeMode: 'none',

  domain: 'lead_intake',

  metadataKeys: [],

  requiresConsent: false,

};

function tc(

  fieldKey: string | null,

  depthLevel: 0 | 1 | 2 = 0,

  event: TelemetryMeta['event'] = 'form_fields_completed',

  redactValue = false,

): TelemetryMeta {

  return { tier: 'C', event, fieldKey, depthLevel, redactValue };

}

function node(

  id: IntakeStepId,

  kind: RouteNodeKind,

  answerKey: keyof IntakeAnswers | null,

  telemetry: TelemetryMeta,

  persistence: PersistenceMeta = NO_PERSIST,

  opts: { optional?: boolean; terminal?: boolean } = {},

): RouteNode {

  return {

    id,

    kind,

    answerKey,

    telemetry,

    persistence,

    optional: opts.optional ?? false,

    terminal: opts.terminal ?? false,

  };

}

/**

 * The email gate is the only node in the graph that writes a lead row *before*

