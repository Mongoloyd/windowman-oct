// RESOLVER

// ═════════════════════════════════════════════════════════════════════════════

function conditionApplies(condition: RouteCondition, state: Readonly<IntakeState>): boolean {

  const intentOk =

    condition.appliesTo === 'all' || condition.appliesTo.includes(state.intent);

  if (!intentOk) return false;

  const stepOk =

    condition.appliesAtStep === 'any' ||

    condition.appliesAtStep.includes(state.currentStepId);

  if (!stepOk) return false;

  return condition.when(state);

}

/** Deterministic priority ordering; ties break on declaration order. */

const ORDERED_ROUTES: readonly RouteCondition[] = [...CONDITIONAL_ROUTES].sort(

  (a, b) => a.priority - b.priority,

);

/**

 * A step is "answered" when its node binds an answerKey and that key is

 * populated. System/gate nodes with no answerKey are never considered

 * unanswered — recovery skips over them rather than stalling on them.

 */

function isAnswered(state: Readonly<IntakeState>, stepId: IntakeStepId): boolean {

  const key = ROUTE_NODES[stepId].answerKey;

  if (key === null) return true;

  return state.answers[key] !== undefined;

}

/**

 * Graceful unknown-step recovery. Instead of jumping blindly to a track head

 * (which wipes psychological context and re-asks answered questions), scan the

 * current intent's sequence for the first unanswered QUESTION and resume there.

 *

 * Runtime flags shape the scan:

 * - leadBanked   → never resume before the pivot; the pre-capture arc is done.

 * - reclassified → the current intent's sequence is already the promoted one;

 *                  preserved answers make the shared head scan as answered, so

 *                  the resume lands naturally on the first track-specific gap.

 *

 * If every question is answered (e.g. a stale resume of a completed run),

 * degrade to the same banked/unbanked terminal pair as sequence exhaustion.

 */

function recoverUnknownStep(state: Readonly<IntakeState>): RouteResolution {

  const flow = FLOW_BY_INTENT[state.intent] ?? FLOW_BY_INTENT[DEFAULT_INTENT];

  const pivotIndex = flow.sequence.indexOf(flow.pivotStepId);

  const scanStart = state.flags.leadBanked ? Math.max(pivotIndex + 1, 0) : 0;

  for (let i = scanStart; i < flow.sequence.length; i += 1) {

    const candidate = flow.sequence[i];

    if (candidate === undefined) continue;

    const nodeDef = ROUTE_NODES[candidate];

    if (nodeDef.terminal) break;

    if (nodeDef.kind === 'question' && !isAnswered(state, candidate)) {

      return { kind: 'goto', stepId: candidate };

    }

  }

  // Nothing left to ask. If unbanked, the email gate itself is the gap.

  if (!state.flags.leadBanked) {

    return { kind: 'goto', stepId: flow.pivotStepId };

  }

  return { kind: 'terminate', stepId: 'salvaged', grade: 'C' };

}

/**

 * Advance along the intent's declared sequence, honouring any `skip` set.

 * Sequence exhaustion is structurally unreachable (every tail ends at

 * `success`), but the guard remains so a future edit cannot reintroduce an

 * undefined-next-step bug: banked runs salvage, unbanked runs soft-exit.

 */

function advanceSequence(

  state: Readonly<IntakeState>,

  skipped: ReadonlySet<IntakeStepId>,

): RouteResolution {

  const flow = FLOW_BY_INTENT[state.intent];

  const index = flow.sequence.indexOf(state.currentStepId);

  if (index === -1) {

    return recoverUnknownStep(state);

  }

  for (let i = index + 1; i < flow.sequence.length; i += 1) {

    const candidate = flow.sequence[i];

    if (candidate === undefined || skipped.has(candidate)) continue;

    return { kind: 'goto', stepId: candidate };

  }

  return state.flags.leadBanked

    ? { kind: 'terminate', stepId: 'salvaged', grade: 'C' }

    : { kind: 'terminate', stepId: 'soft_exit', grade: 'D' };

}

/**

 * Single pure entry point. Given a state snapshot, return the next routing

 * instruction. The reducer owns all mutation; this function owns all decisions.

 */

export function resolveNextStep(

  state: Readonly<IntakeState>,

  skipped: ReadonlySet<IntakeStepId> = new Set<IntakeStepId>(),

): RouteResolution {

  // Terminal nodes are absorbing — never advance past them.

  if (ROUTE_NODES[state.currentStepId].terminal) {

    return { kind: 'continue' };

  }

  for (const condition of ORDERED_ROUTES) {

    if (!conditionApplies(condition, state)) continue;

    const resolution = condition.then(state);

    // `continue` from a matched rule means "no special routing" — fall through

    // to normal sequence advancement rather than short-circuiting.

    if (resolution.kind === 'continue') break;

    // A `skip` resolves immediately into the next non-skipped sequence step so

    // callers never have to run the resolver twice.

    if (resolution.kind === 'skip') {

      const merged = new Set<IntakeStepId>(skipped);

      for (const id of resolution.stepIds) merged.add(id);

      return advanceSequence(state, merged);

    }

    return resolution;

  }

  return advanceSequence(state, skipped);

}

/**

 * Derived guard for the reducer: anything at or past the pivot has a

 * server-side row, so failures degrade instead of losing the person.

 */

export function isPastPivot(state: Readonly<IntakeState>): boolean {

  const flow = FLOW_BY_INTENT[state.intent];

  const pivotIndex = flow.sequence.indexOf(flow.pivotStepId);

  const currentIndex = flow.sequence.indexOf(state.currentStepId);

  return currentIndex >= 0 && pivotIndex >= 0 && currentIndex >= pivotIndex;

}

Notes on the judgment calls:

Reclassified tracks share the C-track head verbatim. Tracks A/B/D open with the identical zip → trigger → depth_probe → scope → email_gate → qualify → reality_check segment. That's not decoration — it's what makes both reclassification and recovery safe: preserved answers occupy identical sequence positions, so recoverUnknownStep scans past them naturally and lands on the first track-specific gap. If you ever diverge the heads, recovery breaks silently.

ghost_quote_stays_on_track uses continue semantics. That required a resolver tweak: a matched rule returning continue now breaks out of rule evaluation and falls through to normal advancement, instead of being swallowed. Version bumped to progressive_intake_v2 since IntakeState shape changed (ghostQuoteFlag, zip_code).

One thing the types can't enforce: reality_check fires after the pivot, so a Track D reclassification means the lead row was already written to lead_intake before you learned they belong in the verified-purchase lane. The reducer must treat Track D as both — the lead row stays (they're still a person to call), and the purchase facts write to the separate domain. Don't let anyone "fix" this by moving the row.

