// ─────────────────────────────────────────────────────────────────────────────

// src/features/intake/flow.ts

// Ordered step sequences per intent. Sequence configuration lives outside React

// so UI variants never require a second state machine.

//

// SOFT-RECLASSIFICATION MODEL: there is no upfront track choice. Every session

// begins on `no_quote` (DEFAULT_INTENT). Tracks A, B, and D are reachable ONLY

// through the reclassification rules at `reality_check` — their sequences exist

// to define the resume path forward, not a from-the-top journey.

// ─────────────────────────────────────────────────────────────────────────────

import type { IntakeIntent, IntakeStepId, IntentFlow } from './types';

/** The one and only entry track. The reducer must initialize with this. */

export const DEFAULT_INTENT: IntakeIntent = 'no_quote';

/**

 * Tail shared by every track after the pivot. Kept as one const so a change to

 * the post-capture spine can't silently drift between tracks. The tail ends at

 * `success` — an explicit terminal — so no sequence can run off the end.

 */

const CONVERGENCE_TAIL = [

  'preview',

  'phone_optional',

  'otp_verify',

  'submitting',

  'mirror',

  'success',

] as const satisfies readonly IntakeStepId[];

export const FLOW_BY_INTENT: Readonly<Record<IntakeIntent, IntentFlow>> = {

  /**

   * TRACK C — the universal ingress track. Zip first (cheapest micro-yes),

   * three affect questions, bank the email, THEN qualify. Qualification runs

   * after capture on purpose: a renter who disqualifies at `qualify_property`

   * is already on the list. `reality_check` sits mid-diagnostic and is the

   * sole point where the other three tracks become reachable.

   */

  no_quote: {

    intent: 'no_quote',

    label: 'Default ingress — no estimate assumed',

    sequence: [

      'zip_code_entry',

      'trigger',

      'depth_probe',

      'scope',

      'email_gate', // ◆ PIVOT

      'qualify_property',

      'reality_check', // ◆ RECLASSIFIER

      'objection_harvest',

      'insurance',

      'timeline_authority',

      'commitment',

      ...CONVERGENCE_TAIL,

    ],

    pivotStepId: 'email_gate',

    terminalStepId: 'success',

    persistenceDomain: 'lead_intake',

  },

  /**

   * TRACK A — reached only via reclassification (`have_paperwork` or

   * `verbal_number`). The head segment (zip → reality_check) mirrors TRACK C

   * so already-banked answers map onto identical positions; resume lands at

   * `estimate_freshness` (paperwork) or `blocked_reason` (verbal).

   */

  quote_review: {

    intent: 'quote_review',

