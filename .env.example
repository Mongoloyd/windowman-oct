# ═══ Supabase ═══
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ═══ Dev Bypass Secret (DEV ONLY) ═══
# MUST match the server-side DEV_BYPASS_SECRET in Supabase Edge Function
# secrets exactly. No brackets, no quotes, no surrounding whitespace.
#
# Read by (DEV builds only — gated on import.meta.env.DEV):
#   - src/hooks/useAnalysisData.ts              (dev bypass for full report fetch)
#   - src/components/dev/DevQuoteGenerator.tsx  (scenario fixture runner)
#   - src/components/TruthReportFindings/VerifyGate.tsx  (auto-skip OTP gate)
#   - src/services/adminDataService.ts          (x-dev-secret header on admin calls)
#
# Server enforcement lives in DEV_BYPASS_SECRET (Supabase secrets) — used by
# supabase/functions/dev-report-unlock and supabase/functions/_shared/adminAuth.ts.
# This client value provides NO security on its own; rotating the server
# secret invalidates all bypass calls regardless of client value.
VITE_DEV_BYPASS_SECRET="your-secret-here"

# ═══ Facebook / Meta ═══
VITE_META_PIXEL_ID="your-pixel-id"

# ═══ Supabase Edge Function Secrets (set via supabase secrets set) ═══
# DEV_BYPASS_SECRET=your-secret-here
# META_PIXEL_ID=your-pixel-id
# META_CAPI_TOKEN=your-conversions-api-access-token
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid
