# ═══ Supabase ═══
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ═══ Dev Bypass Secret ═══
# MUST match DEV_BYPASS_SECRET in Supabase Edge Function secrets exactly.
# No brackets, no quotes, no surrounding whitespace.
# Used by: supabase/functions/dev-report-unlock + client-side dev panel.
VITE_DEV_BYPASS_SECRET="your-secret-here"

# ═══ Facebook / Meta ═══
VITE_META_PIXEL_ID="your-pixel-id"

# ═══ Supabase Edge Function Secrets (set via supabase secrets set) ═══
# DEV_BYPASS_SECRET=your-secret-here
# META_PIXEL_ID=your-pixel-id
# META_CAPI_TOKEN=your-conversions-api-access-token
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid
