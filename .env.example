# ═══ Supabase ═══
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"

# ═══ Dev Bypass (DEV ONLY — NO BUILD-TIME SECRET) ═══
# The client-side dev bypass is no longer read from the build env.
# It is stored in browser localStorage at runtime via window.prompt:
#   - First DEV-only action prompts: "Enter DEV_BYPASS_SECRET (cancel to use normal OTP flow):"
#   - Value persists in localStorage.wm_dev_secret
#   - To clear: localStorage.removeItem('wm_dev_secret') in DevTools
# Implementation: src/lib/devSecret.ts
#
# Server enforcement (the only real boundary) lives in DEV_BYPASS_SECRET
# (Supabase secrets) — used by supabase/functions/dev-report-unlock and
# supabase/functions/_shared/adminAuth.ts. Rotating the server secret
# instantly invalidates every browser's stored value.

# ═══ Facebook / Meta ═══
VITE_META_PIXEL_ID="your-pixel-id"

# ═══ Supabase Edge Function Secrets (set via supabase secrets set) ═══
# Dev bypass for _shared/adminAuth.ts and dev-report-unlock.
# MUST remain unset or "false" in production. Setting to "true"
# enables the x-dev-secret header to grant super_admin access.
# DEV_BYPASS_ENABLED=false
# DEV_BYPASS_SECRET=your-secret-here
# META_PIXEL_ID=your-pixel-id
# META_CAPI_TOKEN=your-conversions-api-access-token
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid
