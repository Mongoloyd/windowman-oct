GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# import-facebook-lead-ad (server-only; never use VITE_ prefixes)
FACEBOOK_LEAD_AD_IMPORT_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
# Fail-safe default: only an explicit false disables test mode.
META_WEBHOOK_TEST_MODE=true
# Trimmed, comma-separated IDs. Test Pages must be exclusive to testing.
# In live mode, an empty pair of lists quarantines native events.
META_TEST_FORM_IDS=
META_TEST_PAGE_IDS=

# Meta Lead Ads asynchronous processing (server-only). Keep delivery paused
# until the approved form destination, consent rules, and live test pass.
META_WORKER_SECRET=
META_GHL_DELIVERY_ENABLED=false
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
META_CRM_FEEDBACK_ENABLED=false
META_CRM_TEST_EVENT_CODE=
META_CRM_LIVE_SEND_ENABLED=false
